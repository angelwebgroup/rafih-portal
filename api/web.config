<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- CORS headers for ALL responses under /api -->
    <httpProtocol>
      <customHeaders>
        <!-- If you use cookies/withCredentials later, change * to http://localhost:8100 -->
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, POST, PUT, DELETE, OPTIONS" />
        <!-- Include Authorization because your requests send the bearer token -->
        <add name="Access-Control-Allow-Headers" value="Content-Type, Authorization, X-Requested-With, Accept" />
        <add name="Access-Control-Allow-Credentials" value="true" />
        <add name="Access-Control-Expose-Headers" value="Authorization" />
      </customHeaders>
    </httpProtocol>

    <!-- Ensure IIS allows OPTIONS -->
    <security>
      <requestFiltering>
        <verbs applyToWebDAV="false">
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
