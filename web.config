<?xml version="1.0" encoding="utf-8"?>
<!-- the root web configuration file -->
<configuration>
  <system.web>
    <compilation tempDirectory="G:\PleskVhosts\rafihportal.com\tmp" />
  </system.web>


 <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect to Admin" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/admin/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>



</configuration>


